module

public import Mathlib
public import Grothendieck.IhesSGA6_2_3
public import StacksFrontier.Algebra.Homology.DerivedCategory.KGroup

@[expose] public section


/-!
# IHÉS FG_IL_5_SGA6_2_3, n° 2: `K(A) ≅ K(D^b(A))` for an abelian category `A`

The Lean section of `FG_IL_5_SGA6_2_3` (`docs/lean/sections/ihes-sga6-2-3.tex`) lists as not
formalised « la comparaison `K(𝒞) ≃ K(D^b(𝒞))` pour une catégorie abélienne, au n° 2 », and
finding `FG_IL_5_SGA6_2_3-K0-triangulated-basics` records the same gap. This file closes it with
the vendored AxiomMath/Stacks result `DerivedCategory.Bounded.exists_addEquiv_K0` (Stacks tag
0FCP, file `StacksFrontier/Algebra/Homology/DerivedCategory/KGroup.lean`), which is stated for
Stacks' `Pretriangulated.K0`.

The edition's group `K₀ C` of `Grothendieck/IhesSGA6_2_3.lean` and Stacks' `Pretriangulated.K0 C`
(tag 0FCN) are the same quotient of `FreeAbelianGroup C` by the subgroup generated by the
`[Y] − [X] − [Z]` of the distinguished triangles, so the two agree definitionally
(`K₀_eq_K0`), and the Stacks theorem applies to the edition's `K₀` as it stands. On the abelian
side the group is Stacks' `KZero A` (tag 02MU), the free abelian group on the objects modulo the
short exact sequences; mathlib has no `K₀` of an abelian category at the pinned revision.

**What is proved.**
* `exists_addEquiv`: for an abelian category `A` with a derived category, an isomorphism
  `e : K(A) ≃ K(D^b(A))` with `e [X] = cl (X[0])`, `X[0]` the complex `X` in degree `0`.
* `addEquiv_unique`: it is the only homomorphism `K(A) → K(D^b(A))` with that property.
* `exists_cl_eq`: hence every element of `K(A)` is the image of the class of a single object of
  `D^b(A)` — the triangulated form of the property that view 4 doubts for abelian categories,
  where only differences `cl X − cl Y` are asserted.

The proof of the comparison is AxiomMath's (an Euler characteristic `K(D^b(A)) → K(A)`,
`Σ (−1)ⁱ [Hⁱ(X)]`, inverse to `X ↦ X[0]`, surjectivity by induction on the length of the
homology); this file only transports it to the edition's `K₀` and draws the corollaries.
-/

namespace Grothendieck.IhesSGA6_2_3Db

open CategoryTheory Limits Pretriangulated Grothendieck.IhesSGA6_2_3

universe w v u

/-- The edition's `K(C)` is Stacks' `K₀(C)` (tag 0FCN), definitionally. -/
theorem K₀_eq_K0 (C : Type u) [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
    [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] :
    K₀ C = Pretriangulated.K0 C := rfl

variable {A : Type u} [Category.{v} A] [Abelian A] [HasDerivedCategory.{w} A]

/-- The object `X[0]` of `D^b(A)`: `X` viewed as a complex concentrated in degree `0`. -/
noncomputable abbrev deg0 (X : A) : DerivedCategory.Bounded A :=
  ⟨(DerivedCategory.singleFunctor A 0).obj X, ⟨⟨0, inferInstance⟩, ⟨0, inferInstance⟩⟩⟩

/-- **`K(A) ≅ K(D^b(A))`** (n° 2; Stacks 0FCP): the class of `X` goes to the class of `X[0]`. -/
theorem exists_addEquiv :
    ∃ e : KZero A ≃+ K₀ (DerivedCategory.Bounded A), ∀ X : A, e (KZero.mk A X) = cl (deg0 X) :=
  DerivedCategory.Bounded.exists_addEquiv_K0 (A := A)

/-- The comparison is unique: a homomorphism `K(A) → K(D^b(A))` is determined by the images of the
classes of objects. -/
theorem addEquiv_unique {f g : KZero A →+ K₀ (DerivedCategory.Bounded A)}
    (hf : ∀ X : A, f (KZero.mk A X) = cl (deg0 X)) (hg : ∀ X : A, g (KZero.mk A X) = cl (deg0 X)) :
    f = g :=
  KZero.hom_ext fun X => (hf X).trans (hg X).symm

/-- Every element of `K(A)` corresponds, under the comparison, to the class of one object of
`D^b(A)` (by `cl_surjective` of the edition's file). -/
theorem exists_cl_eq :
    ∃ e : KZero A ≃+ K₀ (DerivedCategory.Bounded A),
      (∀ X : A, e (KZero.mk A X) = cl (deg0 X)) ∧
        ∀ y : KZero A, ∃ K : DerivedCategory.Bounded A, e.symm (cl K) = y := by
  obtain ⟨e, he⟩ := exists_addEquiv (A := A)
  refine ⟨e, he, fun y => ?_⟩
  obtain ⟨K, hK⟩ := cl_surjective (e y)
  exact ⟨K, by rw [hK, AddEquiv.symm_apply_apply]⟩

end Grothendieck.IhesSGA6_2_3Db

#print axioms Grothendieck.IhesSGA6_2_3Db.exists_addEquiv
#print axioms Grothendieck.IhesSGA6_2_3Db.addEquiv_unique
#print axioms Grothendieck.IhesSGA6_2_3Db.exists_cl_eq
